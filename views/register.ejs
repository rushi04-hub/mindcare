<!DOCTYPE html>
<html>
<head>
    <title>MindCare Registration</title>
</head>
<body>

<h1>MindCare Mental Health Platform</h1>

<h2>Registration Form</h2>

<form action="/register" method="POST">

    <input
        type="text"
        name="name"
        placeholder="Name"
        required>

    <br><br>

    <input
        type="email"
        name="email"
        placeholder="Email"
        required>

    <br><br>

    <input
        type="password"
        name="password"
        placeholder="Password"
        required>

    <br><br>

    <button type="submit">
        Register
    </button>

</form>

</body>
</html>