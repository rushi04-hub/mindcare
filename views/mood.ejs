<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mood Tracking</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:url('https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1600&q=80');
    background-size:cover;
    background-position:center;
}

.card{
    width:450px;
    padding:35px;
    border-radius:25px;
    background:rgba(255,255,255,0.15);
    backdrop-filter:blur(12px);
    color:white;
    box-shadow:0 8px 32px rgba(0,0,0,0.25);
}

h1{
    text-align:center;
    margin-bottom:10px;
}

.subtitle{
    text-align:center;
    margin-bottom:25px;
}

select, textarea{
    width:100%;
    padding:14px;
    border:none;
    border-radius:12px;
    margin-bottom:20px;
    font-size:15px;
}

textarea{
    height:120px;
    resize:none;
}

button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#00c896;
    color:white;
    font-size:16px;
    font-weight:600;
    cursor:pointer;
}

button:hover{
    transform:translateY(-2px);
}

label{
    display:block;
    margin-bottom:8px;
    font-weight:500;
}
</style>
</head>

<body>

<div class="card">

<h1>😊 Mood Tracker</h1>
<p class="subtitle">Track your emotions and improve your wellbeing</p>

<form action="/mood" method="POST">

<label>How are you feeling today?</label>

<select name="mood">
    <option>😊 Happy</option>
    <option>😢 Sad</option>
    <option>😡 Angry</option>
    <option>😰 Stressed</option>
    <option>😌 Relaxed</option>
</select>

<label>Write your thoughts</label>

<textarea
name="note"
placeholder="Tell us how your day went..."></textarea>

<button type="submit">
    Save Mood
</button>

</form>

</div>

</body>
</html>