<!DOCTYPE html>
<html>
<head>
    <title>Mood Tracking</title>
</head>
<body>

<h1>Mood Tracking</h1>

<form action="/mood" method="POST">

    <select name="mood">

        <option>Happy</option>
        <option>Sad</option>
        <option>Angry</option>
        <option>Stressed</option>
        <option>Relaxed</option>

    </select>

    <br><br>

    <textarea
        name="note"
        placeholder="Write your feelings">
    </textarea>

    <br><br>

    <button type="submit">
        Save Mood
    </button>

</form>

</body>
</html>